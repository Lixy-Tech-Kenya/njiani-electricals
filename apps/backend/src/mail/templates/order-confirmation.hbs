<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: sans-serif; line-height: 1.6; color: #333; }
        .container { width: 100%; max-width: 600px; margin: 0 auto; border: 1px solid #ddd; padding: 20px; border-radius: 8px; }
        .header { background: #1a1a2e; color: #fff; padding: 15px; text-align: center; border-radius: 6px 6px 0 0; }
        .order-info { margin: 20px 0; }
        .table { width: 100%; border-collapse: collapse; }
        .table th, .table td { border-bottom: 1px solid #eee; padding: 10px; text-align: left; }
        .footer { font-size: 12px; color: #777; margin-top: 30px; text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Njiani Electricals</h1>
        </div>
        <p>Hello {{customerName}},</p>
        <p>Thank you for your order! We have received your request and are currently processing it.</p>
        
        <div class="order-info">
            <p><strong>Order Reference:</strong> {{referenceNumber}}</p>
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each order.items}}
                    <tr>
                        <td>{{productName}}</td>
                        <td>{{quantity}}</td>
                        <td>{{formattedUnitPrice}}</td>
                    </tr>
                    {{/each}}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2"><strong>Total</strong></td>
                        <td><strong>{{totalAmount}}</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        
        <p>We will contact you shortly regarding delivery and payment details.</p>
        
        <div class="footer">
            <p>&copy; 2024 Njiani Electricals Limited. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
