# Database
DATABASE_URL="postgresql://njiani:njiani_pass@localhost:5432/njiani_db"

# JWT
JWT_SECRET="replace-with-a-secure-secret-key"
JWT_EXPIRES_IN="7d"

# Email — Gmail SMTP (free)
# 1. Enable 2-Step Verification on Google account
# 2. Visit https://myaccount.google.com/apppasswords → create App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Njiani Electricals <your-gmail@gmail.com>"

# WhatsApp — Meta Cloud API (free)
# 1. https://developers.facebook.com → New App → Business → Add WhatsApp product
# 2. Copy Access Token and Phone Number ID from WhatsApp > API Setup
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Business contacts
BUSINESS_EMAIL="orders@njiani.co.ke"
BUSINESS_WHATSAPP="+254746079183"
BUSINESS_NAME="Njiani Electricals Limited"

# App
PORT=3500
NODE_ENV="development"
FRONTEND_URL="http://localhost:3501"
ADMIN_URL="http://localhost:3502"
