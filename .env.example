# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=njiani
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=njiani_db
# Local dev:   postgresql://njiani:njiani_pass@localhost:5434/njiani_db?schema=public
# Neon (prod): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/njiani_db?sslmode=require
DATABASE_URL=postgresql://njiani:change-me-strong-password@localhost:5434/njiani_db?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local dev:    redis://localhost:6380
# Upstash prod: rediss://default:TOKEN@region.upstash.io:6379
REDIS_URL=redis://localhost:6380

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-hex-secret
JWT_EXPIRES_IN=1d

# ─── Image Uploads (Supabase Storage) ───────────────────────────────────────
# Dashboard › Project Settings › API — use the service_role key (not anon)
# Leave empty to fall back to local disk (dev only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket must exist and be set to public in the Supabase dashboard
SUPABASE_STORAGE_BUCKET=product-images

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Dev:  Mailtrap sandbox (https://mailtrap.io)
# Prod: Brevo free tier (300 emails/day) or Resend free tier (100 emails/day)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
SMTP_FROM="Njiani Electricals <no-reply@njiani.co.ke>"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3500
NODE_ENV=development
# Production: set to actual Vercel deployment URLs
FRONTEND_URL=http://localhost:3501
ADMIN_URL=http://localhost:3502
